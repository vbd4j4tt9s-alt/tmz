--!nocheck
-- R158 PROPOSAL (preview, NOT in src/): the new bat swing. Same API as src/ReplicatedStorage/BatSwingPose.lua (Sample(name,time,lead,isR6) ->
-- parent-space joint CFrame, weight), so BatClient would only swap the module. Timed on the reference video (see animation.md):
--   load .00-.07 (fast) -> coil .07-.22 (slow drift, the "hold") -> strike .22-.30 (accelerating; the bat sweeps from behind the head round
--   the right side) -> CONTACT .30 (bat straight ahead at hip height = today's server Windup) -> through .30-.335 (bat out to the left) ->
--   follow-through .335-.52 (wraps low to the left, slowing: the weight) -> hold .52-.60 -> recovery .60-.85 (rises in front, blends back into
--   the tool hold). Upper body only: right arm, left arm, waist (R6: the whole-body RootJoint at 60 % twist, no lean, its own one-piece arm).
-- Keys: generated by make_pose158.py from solve_keys158.py (an IK fit of where the bat should be, on an approximate blocky rig).
local P={Total=.85,Contact=.30,HitFrom=.24,HitTo=.36,TrailFrom=.21,TrailTo=.40}
local function a(x,y,z)return CFrame.Angles(math.rad(x),math.rad(y),math.rad(z))end
-- key order: A 0.070 A2 0.220 B 0.260 C 0.300 D 0.335 E 0.520 F 0.720
local poses={
 RightShoulder={a(44,29,60),a(34,16,52),a(7,25,-41),a(47,-8,-32),a(84,23,-46),a(-169,32,-140),a(170,147,-151)},
 RightElbow={a(130,0,0),a(147,0,0),a(150,0,0),a(54,0,0),a(0,0,0),a(0,0,0),a(119,0,0)},
 RightWrist={a(-18,-6,-5),a(-1,2,-2),a(2,-33,5),a(-88,-17,-2),a(-77,-6,-6),a(-62,4,-2),a(-52,-37,-3)},
 LeftShoulder={a(20,0,-6),a(28,6,-6),a(12,0,-10),a(-20,0,-18),a(-28,-5,-26),a(-25,-5,-24),a(0,0,-8)},
 LeftElbow={a(20,0,0),a(25,0,0),a(20,0,0),a(15,0,0),a(20,0,0),a(22,0,0),a(12,0,0)},
 Waist={a(-4,-25,3),a(-5,-35,4),a(-8,-15,1),a(-12,12,-3),a(-12,38,-5),a(-10,55,-6),a(-4,22,-2)},
}
local r6={
 RightShoulder={a(-178,38,-35),a(-168,24,-29),a(-179,-62,70),a(178,-179,119),a(171,120,-141),a(-125,48,-158),a(-125,175,168)},
 LeftShoulder={a(20,0,-6),a(28,6,-6),a(12,0,-10),a(-20,0,-18),a(-28,-5,-26),a(-25,-5,-24),a(0,0,-8)},
 Waist={a(0,-15,0),a(0,-21,0),a(0,-9,0),a(0,7,0),a(0,23,0),a(0,33,0),a(0,13,0)},
}
local function smooth(t)t=math.clamp(t,0,1);return t*t*(3-2*t)end
local function outQuad(t)t=math.clamp(t,0,1);return 1-(1-t)*(1-t)end
local function outCubic(t)t=math.clamp(t,0,1);return 1-(1-t)^3 end
-- lead: seconds of the swing that passed before this client first saw it (the load restarts from there, as today)
function P.Sample(name,time,lead,isR6)
 if name=='RootJoint'then name='Waist'end
 local k=(isR6 and r6 or poses)[name];if not k then return CFrame.new(),0 end
 if time<0 or time>=P.Total then return CFrame.new(),0 end
 local A,A2,B,C,D,E,F=k[1],k[2],k[3],k[4],k[5],k[6],k[7]
 if time<.07 then
  local start=math.clamp(tonumber(lead)or 0,0,.07*.6)
  return A,outQuad((time-start)/(.07-start))                -- load: fast out of the tool hold
 end
 if time<.22 then return A:Lerp(A2,smooth((time-.07)/.15)),1 end -- coil: a slow drift, never a frozen hold
 if time<.30 then
  local s=((time-.22)/.08)^2                                 -- strike: accelerating, fastest at contact; B at .26 (s = .25)
  if s<.25 then return A2:Lerp(B,s/.25),1 end
  return B:Lerp(C,(s-.25)/.75),1
 end
 if time<.335 then return C:Lerp(D,(time-.30)/.035),1 end    -- through: still fast, the bat goes out to the left
 if time<.52 then return D:Lerp(E,outCubic((time-.335)/.185)),1 end -- follow-through: slows down (the weight)
 if time<.60 then return E,1 end
 if time<.72 then return E:Lerp(F,smooth((time-.60)/.12)),1 end -- recovery: the bat rises in front
 return F,1-smooth((time-.72)/(P.Total-.72))                   -- and blends back into the tool hold
end
return P
