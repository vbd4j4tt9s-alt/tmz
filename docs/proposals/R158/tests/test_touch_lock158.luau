--!nocheck
-- R158 touch lock (owner: "mobile ... the layout is currently ok and frozen"): NOTHING on a touch screen - phone or tablet, landscape or portrait - may move when the PC HUD
-- becomes the scaled 1920 x 1080 arrangement. For one touch screen (run_hud158.sh runs it once per screen, a process each: the mock is global) the REAL scripts of this checkout
-- (the Hotbar, GardenWallet, WorldStatusHud, PityBars155, the menu wheel with its five options, TravelButtons) are built on the Roblox mock with the thumb controls and the safe-area
-- insets, and a fingerprint (FNV-1a over the canonical text, every number at 17 digits) is taken of:
--   read      HudLayout.Read (every field, the sign of a zero too)           boxes_closed / boxes_open   HudLayout.HudBoxes without / with the wheel
--   hotbar, wallet, status, bars, wheel_closed, wheel_open, daily, travel      the GUI tree of each ScreenGui: class, name, Position, Size, AnchorPoint, Visible, TextSize and
--                                                                              every UIScale, children in order (so a new UIScale, a moved pixel or a new instance shows)
--   pity      PityBars155's DefaultDock / Place / Reserved / NameRows / ButtonSpot (the BONUS ROLL button, with the open wheel and the notice rows)
--   card      RarePullCard.SkipBoxes + SkipRect (the SKIP pill) and FitBand for a Common and a Secret card, the in-place card too
--   guide     BeginnerGuide.Obstacles (the three relaxations), HotbarDetail and Card (the tutorial card)
-- The GOLDEN table below was taken from the code before the PC rework (git: the commit before "R158 PC HUD lock"); a touch screen must give the same numbers byte for byte.
-- Usage: luau test_touch_lock158.luau -a <tag> <w> <h> <ix> <iy> <vw> <vh>     (-a golden <tag> ... prints the table lines)    Prints "R158 touch lock <tag>: N pieces, fails 0".
local args={...}
local golden=args[1]=='golden';local dump=args[1]=='dump'
if golden or dump then table.remove(args,1)end
local TAG,W_,H_,IX_,IY_,VW_,VH_=table.unpack(args)
local Scene=require('./hud_world158')
local W,R=Scene.W,Scene.R;local V2=R.Vector2.new
local fmt=string.format
local w,h,ix,iy,vw,vh=tonumber(W_),tonumber(H_),tonumber(IX_),tonumber(IY_),tonumber(VW_),tonumber(VH_)
local S=Scene.build({w=w,h=h,touch=true,ix=ix,iy=iy,vw=vw,vh=vh})
local pg,Hud,B=S.pg,S.Hud,S.Bars
local ser,hash=S.ser,S.hash
local touch=true;local c=S.controls
local Card=W.module('RarePullCard');local Rules=W.module('RarePullRules');local TBR=W.module('TreadmillBonusRules');local Guide=W.module('BeginnerGuide');local Notice=W.module('HudNoticeLayout')
local out={}
local function put(name,text)out[#out+1]={name,hash(text),#text,text}end
local function treeOf(name)local g=pg:FindFirstChild(name);return g and S.tree(g)or'(missing '..name..')'end
-- the layout and its boxes -------------------------------------------------------------------------------------------------------------------------------------------------------
local m=Hud.Read(V2(w,h),touch,c)
put('read',ser(m))
put('boxes_closed',ser(Hud.HudBoxes(m,w,h,false)));put('boxes_open',ser(Hud.HudBoxes(m,w,h,true)))
-- the GUI trees: wheel closed, then open ------------------------------------------------------------------------------------------------------------------------------------------
put('hotbar',treeOf('ChestToolHotbar'));put('wallet',treeOf('ChestEconomyUI'));put('status',treeOf('WorldStatus'));put('bars',treeOf('PackPityBars155'));put('daily',treeOf('DailyRewardsGui'))
put('travel',treeOf('TravelButtons'));put('wheel_closed',treeOf('GardenNavigation'))
S.openWheel(true)
put('wheel_open',treeOf('GardenNavigation'));put('bars_placed',ser({Dock=S.Pity.Dock,Metrics=S.Pity.Metrics~=nil}))
S.openWheel(false)
-- the pieces other scripts ask the layout for ------------------------------------------------------------------------------------------------------------------------------------
do
 local dock=B.DefaultDock(m,w,h);local place=B.Place(w,h,m,dock);local res=B.Reserved(w,h,m,dock)
 local rows=m.HotbarDetails~=false and B.NameRows(w,h,m,dock,place)or{}
 local rowsUp=B.NameRow(w,h,m,dock,place)
 local wheel=Hud.HudBoxes(m,w,h,true)
 local notice={}
 for name,r in pairs(Notice.Calculate(w,h,36,TBR.NoticeFlags))do if type(r)=='table'then notice[#notice+1]={N=name,X=r.X-r.Width/2,Y=r.Y,W=r.Width,H=r.Height}end end
 table.sort(notice,function(a,b)return a.N<b.N end)
 local btn=B.ButtonSpot(TBR,m,w,h,wheel,notice)
 put('pity',ser({Dock=dock,Place=place,Reserved=res,Rows=rows,RowsUp=rowsUp,Button=btn,Extent=B.Extent(place.Pair,place.Bar.W,place.Bar.H),Skip=B.SkipZone(w,h)}))
end
do
 local gui=pg:FindFirstChild('ChestToolHotbar');local vp=V2(vw,vh);local phone=math.min(w,h)<500 or touch
 local boxes=Card.SkipBoxes(w,h,touch,c);local sx,sy,sw,sh=Card.SkipRect(w,h,touch,boxes)
 local bands={}
 for _,spec in ipairs({{1,false},{5,false},{8,false},{5,true}})do local top,bottom=Card.FitBand(gui,vp,spec[1],phone,spec[2]);bands[#bands+1]={top,bottom}end
 put('card',ser({Boxes=boxes,Skip={sx,sy,sw,sh},Bands=bands,Corner={Card.SkipRect(w,h,touch,Card.ControlBoxes(c))}}))
end
do
 local g={}
 for _,relaxed in ipairs({false,1,2})do g[#g+1]=Guide.Obstacles(m,w,h,relaxed or nil)end
 local heightFor=function(width)return 90+math.floor(300/math.max(1,width/100))end
 put('guide',ser({Obstacles=g,Detail=Guide.HotbarDetail(m,h),Card1=Guide.Card(w,h,m,heightFor,nil,nil,420),Card2=Guide.Card(w,h,m,heightFor,1,nil,300),Card3=Guide.Card(w,h,m,heightFor,2,60,260),Font=Guide.Font(m,w,h)}))
end
if golden then
 for _,o in ipairs(out)do print(fmt('GOLDEN\t%s:%s\t%s',TAG,o[1],o[2]))end
 return
end
if dump then -- (the canonical text of every piece, to see what moved)
 for _,o in ipairs(out)do print('=== '..o[1]..' '..o[2]);print(o[4])end
 return
end
