 -- 8f. the stem, tendril / curl and leaf sit on the REAL mesh surface (the R134 check sees the mesh as its box): every small part touches
 -- the generated triangles (signed distance <= .03 studs) or a part that does (R151: there is no gloss patch any more)
 local function sub(a,b)return {a[1]-b[1],a[2]-b[2],a[3]-b[3]}end
 local function dot(a,b)return a[1]*b[1]+a[2]*b[2]+a[3]*b[3]end
 local function along(a,b,t)return {a[1]+b[1]*t,a[2]+b[2]*t,a[3]+b[3]*t}end
 local function closest(p,a,b,c) -- the closest point of triangle abc to p (Ericson, Real-Time Collision Detection 5.1.5)
  local ab,ac,ap=sub(b,a),sub(c,a),sub(p,a);local d1,d2=dot(ab,ap),dot(ac,ap)
  if d1<=0 and d2<=0 then return a end
  local bp=sub(p,b);local d3,d4=dot(ab,bp),dot(ac,bp)
  if d3>=0 and d4<=d3 then return b end
  local vc=d1*d4-d3*d2
  if vc<=0 and d1>=0 and d3<=0 then return along(a,ab,d1/(d1-d3))end
  local cp=sub(p,c);local d5,d6=dot(ab,cp),dot(ac,cp)
  if d6>=0 and d5<=d6 then return c end
  local vb=d5*d2-d1*d6
  if vb<=0 and d2>=0 and d6<=0 then return along(a,ac,d2/(d2-d6))end
  local va=d3*d6-d5*d4
  if va<=0 and(d4-d3)>=0 and(d5-d6)>=0 then return along(b,sub(c,b),(d4-d3)/((d4-d3)+(d5-d6)))end
  local den=1/(va+vb+vc);return along(along(a,ab,vb*den),ac,vc*den)
 end
 local function samples(p)local h=p.Size/2;local out={}
  for _,o in ipairs({{0,0,0},{h.X,0,0},{-h.X,0,0},{0,h.Y,0},{0,-h.Y,0},{0,0,h.Z},{0,0,-h.Z}})do local w=p.CFrame:PointToWorldSpace(V3(o[1],o[2],o[3]));out[#out+1]={w.X,w.Y,w.Z}end
  return out
 end
 local function inside(pt,q,tol)local l=q.CFrame:PointToObjectSpace(V3(pt[1],pt[2],pt[3]));local h=q.Size/2;return math.abs(l.X)<=h.X+tol and math.abs(l.Y)<=h.Y+tol and math.abs(l.Z)<=h.Z+tol end
 for _,id in ipairs(MESHIDS)do for i=1,Catalog[id].FruitCount do
  local model=hotbar(id,i);local mesh;local small={}
  for _,p in ipairs(parts(model,true))do if p.ClassName=='MeshPart'then mesh=p else table.insert(small,p)end end
  local rec=mesh.MeshContent;local T={}
  for k,v in ipairs(rec.V)do local w=mesh.CFrame:PointToWorldSpace(V3(v[1]*mesh.Size.X,v[2]*mesh.Size.Y,v[3]*mesh.Size.Z));T[k]={w.X,w.Y,w.Z}end
  local function signed(pt)
   local best,sign=math.huge,1
   for _,f in ipairs(rec.F)do
    local a,b,c=T[f[1]],T[f[2]],T[f[3]];local d=sub(pt,closest(pt,a,b,c));local dd=math.sqrt(dot(d,d))
    if dd<best then best=dd;local u,w=sub(b,a),sub(c,a);sign=dot(d,{u[2]*w[3]-u[3]*w[2],u[3]*w[1]-u[1]*w[3],u[1]*w[2]-u[2]*w[1]})<0 and -1 or 1 end
   end
   return best*sign
  end
  local reached={}
  for _,p in ipairs(small)do
   local m=math.huge;for _,pt in ipairs(samples(p))do m=math.min(m,signed(pt))end
   if m<=.03 then reached[p]=true end
  end
  local grew=true
  while grew do grew=false
   for _,p in ipairs(small)do if not reached[p]then
    for _,q in ipairs(small)do if reached[q]then
     local touch=false;for _,pt in ipairs(samples(p))do if inside(pt,q,.03)then touch=true end end;for _,pt in ipairs(samples(q))do if inside(pt,p,.03)then touch=true end end
     if touch then reached[p]=true;grew=true;break end
    end end
   end end
  end
  local loose={};for _,p in ipairs(small)do if not reached[p]then loose[#loose+1]=p.Name end end
  local noShine=true;for _,p in ipairs(small)do local n=string.lower(p.Name);if n:find('gloss',1,true)or n:find('glint',1,true)or n:find('shine',1,true)then noShine=false end end
  check(#loose==0 and #small==3,id..' fruit '..i..': stem, tendril / curl and leaf hang on the real mesh surface ('..(#loose>0 and'loose: '..table.concat(loose,', ')or'none loose')..')')
  check(noShine,id..' fruit '..i..': no gloss patch on the mesh (R151)')
 end end
 local tris=0;for _,id in ipairs(MESHIDS)do tris=math.max(tris,MESHFRUIT[id].Tris*Catalog[id].FruitCount)end
 print(('INFO phones: at most %d mesh triangles per plant (2 fruit); 6 templates of 242 - 258 vertices in all'):format(tris))
end

