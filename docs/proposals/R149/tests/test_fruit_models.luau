do
 local function fnv(t)local h=2166136261;for i=1,#t do h=bit32.bxor(h,string.byte(t,i));h=(h*16777619)%4294967296 end;return string.format('%08x',h)end
 -- the reviewed designs (fruit_meshes.png): values to 4 decimals, colours to 3, triangles. Change on purpose only (re-render the preview).
 local DIGEST={EmberPumpkin149='7cc3c198',SnowMelon149='86c683b0',Watermelon149='54c08b90'}
 local byKey={};for _,id in ipairs(MESHIDS)do byKey[MESHFRUIT[id].Key]=MESHFRUIT[id]end
 local generated={}
 -- 8a. the generator
 for _,key in ipairs(FM.Keys)do
  local m=byKey[key];local t0=os.clock();local d=FM.Generate(key);local took=os.clock()-t0;generated[key]=d
  check(deepEqual(d,FM.Generate(key)),key..': the generator is deterministic')
  local V,N,C,Fc=d.Vertices,d.Normals,d.Colors,d.Faces
  check(#V==m.Verts and #N==#V and #C==#V and #Fc==m.Tris and #Fc<=512,('%s: %d vertices, %d triangles (<= 512, for phones), a normal and a colour per vertex'):format(key,#V,#Fc))
  local box=true
  for k=1,3 do local lo,hi=math.huge,-math.huge;for _,p in ipairs(V)do lo=math.min(lo,p[k]);hi=math.max(hi,p[k])end;if not(near(lo,-.5,1e-9)and near(hi,.5,1e-9))then box=false end end
  check(box,key..': normalised to the -0.5 .. 0.5 box on every axis (the spec size scales it, like ApprovedPlantMeshData)')
  local unit=true;for _,n in ipairs(N)do if not near(math.sqrt(n[1]^2+n[2]^2+n[3]^2),1,1e-6)then unit=false end end
  check(unit,key..': unit vertex normals')
  local colOk=true;for _,c in ipairs(C)do for k=1,3 do if c[k]<0 or c[k]>1 then colOk=false end end end
  check(colOk,key..': colours in 0 .. 1')
  local valid,outward,area=true,true,true;local edges={}
  for _,f in ipairs(Fc)do
   local a,b,c=f[1],f[2],f[3]
   if not(V[a]and V[b]and V[c])or a==b or b==c or a==c then valid=false else
    local p,q,r=V[a],V[b],V[c];local u={q[1]-p[1],q[2]-p[2],q[3]-p[3]};local w={r[1]-p[1],r[2]-p[2],r[3]-p[3]}
    local x={u[2]*w[3]-u[3]*w[2],u[3]*w[1]-u[1]*w[3],u[1]*w[2]-u[2]*w[1]}
    if math.sqrt(x[1]^2+x[2]^2+x[3]^2)<1e-9 then area=false end
    local nn={N[a][1]+N[b][1]+N[c][1],N[a][2]+N[b][2]+N[c][2],N[a][3]+N[b][3]+N[c][3]}
    if x[1]*nn[1]+x[2]*nn[2]+x[3]*nn[3]<=0 then outward=false end
    for _,e in ipairs({{a,b},{b,c},{c,a}})do local k=e[1]..'>'..e[2];edges[k]=(edges[k]or 0)+1 end
   end
  end
  local closed=true;for k,n in pairs(edges)do local a,b=k:match('(%d+)>(%d+)');if n~=1 or edges[b..'>'..a]~=1 then closed=false end end
  check(valid and area,key..': every triangle has three distinct vertices and an area')
  check(outward,key..': every triangle faces outward (its winding agrees with its vertex normals, as in the place\'s baked meshes)')
  check(closed,key..': closed and consistently wound (every edge used once each way)')
  local o={};for _,p in ipairs(V)do o[#o+1]=('%.4f,%.4f,%.4f'):format(p[1],p[2],p[3])end;for _,c in ipairs(C)do o[#o+1]=('%.3f,%.3f,%.3f'):format(c[1],c[2],c[3])end
  for _,f in ipairs(Fc)do o[#o+1]=f[1]..','..f[2]..','..f[3]end
  local digest=fnv(table.concat(o,';'))
  check(digest==DIGEST[key],key..': the generated mesh is the reviewed design (digest '..digest..')')
  print(('INFO %s: %d vertices, %d triangles, generated in %.2f ms; %d numbers (%.1f KB as doubles) held only while it bakes'):format(key,#V,#Fc,took*1000,#V*9+#Fc*3,(#V*9+#Fc*3)*8/1024))
 end
